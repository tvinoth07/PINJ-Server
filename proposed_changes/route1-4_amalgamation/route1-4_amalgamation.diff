+/* ----------------------------------------------------------------------------
+ * PROFILE AMALGAMATION (route extension — ROUTE1..ROUTE4)
+ *
+ * When a route is extended, the MA and profiles sent to the Loco commence at
+ * the foot of the signal to the rear of the LRT (DIST_PKT_START is then a
+ * NEGATIVE value — see encode_pkt9()), and the profiles of the currently
+ * occupied section and of the newly extended route(s) are amalgamated into
+ * ONE sub-packet per type. Sending the same SUB_PKT_TYPE twice is not valid
+ * (decoder.py's decode_station_to_onboard() stops at the first repeated type).
+ *
+ * ROUTE1..ROUTE4 are taken in that order (ROUTE1 = the currently occupied
+ * section, nearest the loco). For each sub-packet type:
+ *   - exactly one route has it  → its bytes are copied verbatim (identical
+ *                                 to the old single-route behaviour), except
+ *                                 LC/Turnout/TCD of a later route, whose
+ *                                 distances are still shifted (see below);
+ *   - two or more routes have it → amalgamated (Annexure-C Amdt-10, C.4.2):
+ *
+ *   SSP / Gradient : LM_*_Distance is the length of each LM segment, so the
+ *       LMs of each profile are combined in route order and the LM count
+ *       aggregated. (Verified on the SKP APD sheet: SSP S.No 1+2+3 =
+ *       1202+1018+1010 = 3230 = S.No 9's span.)
+ *   LC Gate / Turnout / Track Condition : entries combined and count
+ *       aggregated, but their distance is measured FROM THE REFERENCE
+ *       position (LM_LC_Distance, DIFF_DIST_TO, START_DIST_TRACKCOND), so
+ *       every entry of route k is shifted by the span of routes 1..k-1.
+ *       A route's span = sum of its SSP LM distances (= the APD "Profile
+ *       Span"), or of its Gradient LM distances when it has no SSP.
+ *       Turnout: DIFF_DIST_TO / TO_SPEED_REL_DIST are only present when
+ *       TO_SPEED is restricted (!= 11111).
+ *   TLI : DIST_NXT_RFID is "from previous RFID", so the tag lists are joined;
+ *       a tag common to two consecutive TLIs is listed only once with the
+ *       inter-tag distances aggregated (one of them is 0). (Verified: TLI of
+ *       S.No 1+2+3 amalgamates byte-for-byte to S.No 9's TLI.)
+ *       DIST_DUP_TAG       — from the first TLI (common for a yard).
+ *       ABS_LOC_RESET      — the first TLI that has one ("in given MA,
+ *                            single location reset is considered").
+ *       ADJ_LINE_CNT/TINs  — "adjacent line TINs along the MA": the TINs of
+ *                            all TLIs, in order, duplicates removed (max 6,
+ *                            ADJ_LINE_CNT = TINs - 1). If the first TLI's
+ *                            ADJ_LINE_CNT is 6/7 (reserved/unknown, no TINs)
+ *                            it is kept as-is.
+ *
+ * The merged sub-packet is re-padded to a byte boundary and SUB_PKT_LENGTH
+ * recomputed. If a count field or the 128-byte sub-packet limit would
+ * overflow, the remaining entries are dropped and a warning goes to stderr —
+ * the packet is never corrupted.
+ * ---------------------------------------------------------------------------- */
+
+#define TP_SUBPKT_MAX_BYTES 128   /* 7-bit SUB_PKT_LENGTH → (127 + 1) bytes */
+
+/** MSB-first bit reader over a decoded sub-packet field (reads 0 past end). */
+typedef struct {
+    const uint8_t *b;
+    int            nbits;
+    int            pos;
+} TpReader;
+
+static uint32_t tp_read(TpReader *rd, int n)
+{
+    uint32_t v = 0;
+    for (int i = 0; i < n; i++) {
+        int p   = rd->pos++;
+        int bit = (p < rd->nbits) ? ((rd->b[p / 8] >> (7 - (p % 8))) & 1) : 0;
+        v = (v << 1) | (uint32_t)bit;
+    }
+    return v;
+}
+
+/** Overwrite @nbits at a previously reserved @bit_pos (generalised bw_backfill_7bit). */
+static void bw_backfill_bits(BitWriter *bw, int bit_pos, uint32_t val, int nbits)
+{
+    for (int i = 0; i < nbits; i++) {
+        int bpos   = bit_pos + i;
+        int byte_i = bpos / 8;
+        int bit_i  = 7 - (bpos % 8);
+        if ((val >> (nbits - 1 - i)) & 1u)
+            bw->buf[byte_i] |=  (uint8_t)(1u << bit_i);
+        else
+            bw->buf[byte_i] &= ~(uint8_t)(1u << bit_i);
+    }
+}
+
+/** Pad @bw to a byte boundary and back-fill SUB_PKT_LENGTH (at bit 4). */
+static int tp_finish_subpkt(BitWriter *bw, uint8_t *out, int max_out)
+{
+    int nbytes = bw_byte_len(bw);
+    if (nbytes > TP_SUBPKT_MAX_BYTES || nbytes > max_out) return 0;
+    bw_backfill_7bit(bw, 4, (uint8_t)(nbytes - 1));
+    memcpy(out, bw->buf, nbytes);
+    return nbytes;
+}
+
+/* One LM / entry of a list-type sub-packet, as up to 3 fields:
+ * f[0..nf-1] with widths w[]; dist_idx = index of the distance field that is
+ * measured from the reference position (-1 = segment length, never shifted). */
+typedef struct {
+    uint32_t f[6];
+    int      w[6];
+    int      nf;
+    int      dist_idx;
+} TpEntry;
+
+static int tp_count_width(int sp_type)
+{
+    switch (sp_type) {
+    case 0x1: case 0x2: case 0x3: return 5;   /* LM_*_Info_CNT    */
+    case 0x4: return 2;                       /* TO_CNT           */
+    case 0x6: return 4;                       /* TRACKCOND_CNT    */
+    default:  return 0;
+    }
+}
+
+/** Read one entry of @sp_type from @rd (C.4.2 field layouts). */
+static void tp_read_entry(int sp_type, TpReader *rd, TpEntry *e)
+{
+    memset(e, 0, sizeof(*e));
+    e->dist_idx = -1;
+#define TP_F(width) do { e->w[e->nf] = (width); e->f[e->nf] = tp_read(rd, (width)); e->nf++; } while (0)
+    switch (sp_type) {
+    case 0x1:                                 /* Static Speed Profile                 */
+        TP_F(15);                             /* LM_Static_Speed_Distance (segment)   */
+        TP_F(1);                              /* LM_Static_Speed_Class                */
+        if (e->f[1]) TP_F(18);                /* Class A,B,C speeds (3 x 6)           */
+        else         TP_F(6);                 /* Universal speed                      */
+        break;
+    case 0x2:                                 /* Gradient                             */
+        TP_F(15); TP_F(1); TP_F(5);           /* Distance (segment), GDIR, VALUE      */
+        break;
+    case 0x3:                                 /* LC Gate                              */
+        TP_F(15); e->dist_idx = 0;            /* LM_LC_Distance (from reference)      */
+        TP_F(10); TP_F(3); TP_F(1); TP_F(3); TP_F(3); /* ID, suffix, manning, class,
+                                                 auto-whistling enabled(1)+type(2)    */
+        break;
+    case 0x4:                                 /* Turnout                              */
+        TP_F(5);                              /* TO_SPEED                             */
+        if (e->f[0] != 0x1F) {                /* only if restricted                   */
+            TP_F(15); e->dist_idx = 1;        /* DIFF_DIST_TO (from reference RFID)   */
+            TP_F(12);                         /* TO_SPEED_REL_DIST                    */
+        }
+        break;
+    case 0x6:                                 /* Track Condition                      */
+        TP_F(4);                              /* TRACKCOND_TYPE                       */
+        TP_F(15); e->dist_idx = 1;            /* START_DIST_TRACKCOND (from ref RFID) */
+        TP_F(15);                             /* LENGTH_TRACKCOND                     */
+        break;
+    }
+#undef TP_F
+}
+
+static int tp_entry_bits(const TpEntry *e)
+{
+    int n = 0;
+    for (int i = 0; i < e->nf; i++) n += e->w[i];
+    return n;
+}
+
+/** Span (m) of a profile = sum of its SSP (or Gradient) LM segment lengths. */
+static uint32_t tp_profile_span(const uint8_t *sub, int len)
+{
+    if (len <= 0) return 0;
+    int sp_type = sub[0] >> 4;
+    TpReader rd = { sub, len * 8, 11 };
+    int cnt = (int)tp_read(&rd, tp_count_width(sp_type));
+    uint32_t span = 0;
+    for (int i = 0; i < cnt && rd.pos < rd.nbits; i++) {
+        TpEntry e;
+        tp_read_entry(sp_type, &rd, &e);
+        span += e.f[0];
+    }
+    return span;
+}
+
+/**
+ * tp_merge_list_subpkts() – amalgamate @nsrc list-type sub-packets of the
+ * same type: entries combined in route order, count aggregated, and (for
+ * LC / Turnout / Track Condition) each entry's from-reference distance
+ * shifted by @offset[s] (span of the routes before it). Returns bytes written.
+ */
+static int tp_merge_list_subpkts(int sp_type,
+                                 const uint8_t *src[], const int src_len[],
+                                 const uint32_t offset[], int nsrc,
+                                 uint8_t *out, int max_out)
+{
+    int cw        = tp_count_width(sp_type);
+    int max_count = (1 << cw) - 1;
+    int max_bits  = TP_SUBPKT_MAX_BYTES * 8;
+
+    BitWriter bw;
+    bw_init(&bw);
+    bw_write(&bw, (uint64_t)sp_type, 4);      /* SUB_PKT_TYPE              */
+    bw_write(&bw, 0, 7);                      /* SUB_PKT_LENGTH (backfill) */
+    int cnt_pos = bw.bit_pos;
+    bw_write(&bw, 0, cw);                     /* count (backfill)          */
+
+    int total = 0, dropped = 0;
+    for (int s = 0; s < nsrc; s++) {
+        TpReader rd = { src[s], src_len[s] * 8, 11 };
+        int cnt = (int)tp_read(&rd, cw);
+        for (int i = 0; i < cnt; i++) {
+            TpEntry e;
+            tp_read_entry(sp_type, &rd, &e);
+            if (rd.pos > rd.nbits) break;     /* malformed / truncated     */
+
+            if (e.dist_idx >= 0) {
+                uint32_t d = e.f[e.dist_idx] + offset[s];
+                if (d > 32767u) {
+                    fprintf(stderr, "[PROFILE_MERGE] SUB_PKT_TYPE %d: distance %u m "
+                                    "clamped to 32767\n", sp_type, d);
+                    d = 32767u;
+                }
+                e.f[e.dist_idx] = d;
+            }
+            if (total >= max_count || bw.bit_pos + tp_entry_bits(&e) > max_bits - 7) {
+                dropped++;                    /* -7: room for byte padding */
+                continue;
+            }
+            for (int k = 0; k < e.nf; k++)
+                bw_write(&bw, e.f[k], e.w[k]);
+            total++;
+        }
+    }
+    if (dropped)
+        fprintf(stderr, "[PROFILE_MERGE] SUB_PKT_TYPE %d: %d entr%s dropped "
+                        "(count/length limit reached)\n",
+                sp_type, dropped, dropped == 1 ? "y" : "ies");
+
+    bw_backfill_bits(&bw, cnt_pos, (uint32_t)total, cw);
+    return tp_finish_subpkt(&bw, out, max_out);
+}
+
+/**
+ * tp_merge_tli_subpkts() – amalgamate @nsrc Tag Linking Information
+ * sub-packets (see the section comment above for the rules). Returns bytes
+ * written.
+ */
+static int tp_merge_tli_subpkts(const uint8_t *src[], const int src_len[], int nsrc,
+                                uint8_t *out, int max_out)
+{
+    enum { TLI_MAX_TAGS = 62, TLI_MAX_TINS = 6 };
+    uint32_t dist[TLI_MAX_TAGS], tag[TLI_MAX_TAGS], dir[TLI_MAX_TAGS];
+    int      ntags = 0, dropped = 0;
+
+    uint32_t dist_dup = 0;
+    uint32_t alr = 0, alr_start = 0, alr_dir = 0, alr_loc = 0;
+    uint32_t first_adj = 0, tins[TLI_MAX_TINS];
+    int      ntins = 0;
+
+    for (int s = 0; s < nsrc; s++) {
+        TpReader rd = { src[s], src_len[s] * 8, 11 };
+        uint32_t dd  = tp_read(&rd, 4);       /* DIST_DUP_TAG              */
+        int      cnt = (int)tp_read(&rd, 6);  /* ROUTE_RFID_CNT            */
+        if (s == 0) dist_dup = dd;
+        if (cnt > TLI_MAX_TAGS) cnt = 0;      /* 63 = reserved             */
+
+        for (int i = 0; i < cnt; i++) {
+            uint32_t d = tp_read(&rd, 11);    /* DIST_NXT_RFID             */
+            uint32_t t = tp_read(&rd, 10);    /* NXT_RFID_TAG_ID           */
+            uint32_t r = tp_read(&rd, 1);     /* DUP_TAG_DIR               */
+
+            /* Tag common to two consecutive TLIs → list it once, aggregate
+             * the inter-tag distances (one of them is 0). */
+            if (i == 0 && ntags > 0 && tag[ntags - 1] == t) {
+                uint32_t sum = dist[ntags - 1] + d;
+                dist[ntags - 1] = (sum > 2047u) ? 2047u : sum;
+                continue;
+            }
+            if (ntags >= TLI_MAX_TAGS) { dropped++; continue; }
+            dist[ntags] = d; tag[ntags] = t; dir[ntags] = r;
+            ntags++;
+        }
+
+        uint32_t a = tp_read(&rd, 1);         /* ABS_LOC_RESET             */
+        uint32_t a_start = 0, a_dir = 0, a_loc = 0;
+        if (a) {
+            a_start = tp_read(&rd, 15);       /* START_DIST_TO_LOC_RESET   */
+            a_dir   = tp_read(&rd, 2);        /* ADJ_LOCO_DIR              */
+            a_loc   = tp_read(&rd, 23);       /* ABS_LOC_CORRECTION        */
+        }
+        if (a && !alr) {                      /* single location reset per MA */
+            alr = 1; alr_start = a_start; alr_dir = a_dir; alr_loc = a_loc;
+        }
+
+        uint32_t adj = tp_read(&rd, 3);       /* ADJ_LINE_CNT              */
+        if (s == 0) first_adj = adj;
+        if (adj <= 5) {                       /* LINE_TIN only for 0..5    */
+            for (uint32_t j = 0; j <= adj; j++) {
+                uint32_t tin = tp_read(&rd, 9);
+                int seen = 0;
+                for (int k = 0; k < ntins; k++) if (tins[k] == tin) seen = 1;
+                if (seen) continue;
+                if (ntins < TLI_MAX_TINS) tins[ntins++] = tin;
+                else fprintf(stderr, "[PROFILE_MERGE] TLI: TIN %u dropped "
+                                     "(max %d)\n", tin, TLI_MAX_TINS);
+            }
+        }
+    }
+    if (dropped)
+        fprintf(stderr, "[PROFILE_MERGE] TLI: %d tag(s) dropped "
+                        "(ROUTE_RFID_CNT limit %d reached)\n", dropped, TLI_MAX_TAGS);
+
+    BitWriter bw;
+    bw_init(&bw);
+    bw_write(&bw, 0x5, 4);                    /* SUB_PKT_TYPE = TLI        */
+    bw_write(&bw, 0, 7);                      /* SUB_PKT_LENGTH (backfill) */
+    bw_write(&bw, dist_dup, 4);
+    bw_write(&bw, (uint64_t)ntags, 6);
+    for (int i = 0; i < ntags; i++) {
+        bw_write(&bw, dist[i], 11);
+        bw_write(&bw, tag[i],  10);
+        bw_write(&bw, dir[i],   1);
+    }
+    bw_write(&bw, alr, 1);
+    if (alr) {
+        bw_write(&bw, alr_start, 15);
+        bw_write(&bw, alr_dir,    2);
+        bw_write(&bw, alr_loc,   23);
+    }
+    if (first_adj > 5 || ntins == 0) {
+        bw_write(&bw, first_adj, 3);          /* reserved/unknown — no TINs */
+    } else {
+        bw_write(&bw, (uint64_t)(ntins - 1), 3);
+        for (int j = 0; j < ntins; j++)
+            bw_write(&bw, tins[j], 9);
+    }
+
+    int n = tp_finish_subpkt(&bw, out, max_out);
+    if (n == 0)
+        fprintf(stderr, "[PROFILE_MERGE] TLI: amalgamated sub-packet exceeds "
+                        "%d bytes — ROUTE1's TLI sent instead\n", TP_SUBPKT_MAX_BYTES);
+    return n;
+}
